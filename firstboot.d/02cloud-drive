#!/bin/bash -e
# Read the Proxmox cloud-init drive of a VM, without the cloud-init
# package (bin/cloud-drive.py --firstboot): the SSH keys go to root's
# authorized_keys, the password is set and ROOT_PASS=KEEP added to the
# inithooks conf so 30rootpass does not ask, and FQDN= or HOSTNAME= is
# added for 09hostname and 31fqdn, which rename the machine. What the
# conf already sets (a preseed, or 00declarative from the instance
# description) wins. Nothing from the drive is run, and the network
# configuration is not applied: keel owns the network.
#
# With a key from the drive, the boot run asks nothing on the console
# (lib/console.sh, INITHOOKS_SSH_ANSWER): the console would hold the
# first boot lock, and keel-init over SSH would be refused. The questions
# go to keel-init, which the first login starts.
#
# Position: after 00declarative, whose conf it adds to, and before
# 09hostname, 29sudoadmin (which copies root's keys to admin) and
# 30rootpass. A no-op in a container, with no drive, under keel-init,
# and for an instance-id already applied.

INITHOOKS_DEFAULT="${INITHOOKS_DEFAULT:-/etc/default/inithooks}"
# shellcheck source=default/inithooks
source "$INITHOOKS_DEFAULT"

[[ -n "${_TURNKEY_INIT:-}" ]] && exit 0

export INITHOOKS_CONF
args=(--firstboot)
[[ "${SUDOADMIN,,}" == "true" ]] && args+=(--sudoadmin)
exec "$INITHOOKS_PATH/bin/cloud-drive.py" "${args[@]}"
