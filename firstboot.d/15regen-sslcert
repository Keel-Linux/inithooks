#!/bin/bash -e
# Regenerate self-signed TLS/SSL cert & key, for the name the machine has
# (lib/sslcert.sh); 31fqdn makes it again when it settles another name.

[[ -n "$_TURNKEY_INIT" ]] && exit 0

INITHOOKS_DEFAULT="${INITHOOKS_DEFAULT:-/etc/default/inithooks}"
# shellcheck source=default/inithooks
source "$INITHOOKS_DEFAULT"
# shellcheck source=lib/sslcert.sh
source "$INITHOOKS_PATH/lib/sslcert.sh"

[[ -e $INITHOOKS_CONF ]] && . "$INITHOOKS_CONF"

HOOK=$(basename "$0")

names=$(sslcert_names)
# shellcheck disable=SC2086 # the names are words
sslcert_make $names

exit 0
