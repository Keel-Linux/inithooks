#! /usr/bin/make -f

export PYBUILD_BEFORE_BUILD=\
	echo usr/lib/python{version.major}/dist-packages/libinithooks/inithooks_cache.py \
	usr/lib/inithooks/bin/inithooks_cache.py \
	> debian/inithooks.links

export PYTHONDONTWRITEBYTECODE=1

%:
	dh $@ --with=python3 --buildsystem=pybuild

# debian/postinst enables inithooks and turnkey-init-fence on a fresh install
# and restarts them on an upgrade only when they were running, so debhelper
# neither enables nor starts them: a start at install would take tty1.
# keel-host-keys.service is enabled by debhelper, on install and on an
# upgrade from a version that did not enable it, and never started by the
# package: started inside an image build it would bake the keys it exists to
# keep out of the image. It runs at the next boot.
# --no-start alone also turns off restart-after-upgrade, and debhelper then
# stops each unit in preinst on every upgrade: keel-host-keys would stay
# inactive until a reboot and confconsole would leave tty1. So no unit is
# stopped on upgrade either. With both flags debhelper does not stop them on
# removal either, so debian/prerm does that.
override_dh_installsystemd:
	dh_installsystemd --name=inithooks --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd --name=inithooks-restart-getty1 --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd --name=turnkey-init-fence --no-enable --no-start --no-stop-on-upgrade
	dh_installsystemd --name=keel-host-keys --no-start --no-stop-on-upgrade
