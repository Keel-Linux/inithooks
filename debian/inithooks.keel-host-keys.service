[Unit]
Description=Give this machine its own SSH, TLS and snakeoil keys
Documentation=https://github.com/Keel-Linux/keel-core/issues/8
# A layer ships no private key, so the keys the services below read are
# generated here, on the machine, before any of them starts, and a key that
# was published inside a Keel image is replaced. See bin/keel-host-keys.
# ssh.socket is not listed: it only listens, and the sshd it spawns per
# connection starts after this unit has finished.
Before=ssh.service webmin.service inithooks.service turnkey-init-fence.service
Before=apache2.service nginx.service lighttpd.service tomcat10.service tomcat11.service
Before=postgresql.service postfix.service
ConditionPathIsReadWrite=/etc

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/inithooks/bin/keel-host-keys

[Install]
WantedBy=multi-user.target
