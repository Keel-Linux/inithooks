#!/bin/sh

set -e

if [ "$1" = "configure" ] || [ "$1" = "abort-upgrade" ] \
        || [ "$1" = "abort-deconfigure" ] || [ "$1" = "abort-remove" ] ; then
    systemctl daemon-reload >/dev/null || true
    if [ -n "$2" ]; then
        # this is an upgrade ($2 is the old version)
        # systemctl restart will start services if not running

        # /run/_service_-was-active is created by preinst script
        if [ -f "/run/inithooks-was-active" ]; then
            rm -f /run/inithooks-was-active
            # restart will start if not running
            systemctl restart inithooks.service
            # unlikely that turnkey-init-fence is running when package is
            # upgraded but just in case
            if [ -f "/run/turnkey-init-fence-was-active" ]; then
                rm -f /run/turnkey-init-fence-was-active
                systemctl restart turnkey-init-fence.service
            fi
        else
            # A login prompt should be on the console already. Make sure
            # there is one without touching the one there is: a restart of
            # the getty ends the session on it, and an operator running apt
            # upgrade from the console (tty1, pct console) was logged out
            # mid-upgrade (2026-10-03). So a getty is only ever started,
            # only when it is inactive, only one the machine has (a
            # container has no getty@tty1), and only once the first boot is
            # over: inithooks.service neither running nor queued, as
            # libinithooks/init_lock.py asks (is-active, then a start job
            # in list-jobs), since the wizard draws on that tty.
            state=$(systemctl is-active inithooks.service 2>/dev/null || true)
            case "$state" in
                active|activating|reloading|deactivating) state=running ;;
                *) if [ -n "$(systemctl list-jobs --no-legend inithooks.service 2>/dev/null)" ]; then
                       state=queued
                   else
                       state=stopped
                   fi ;;
            esac
            if [ "$state" = stopped ]; then
                for unit in getty@tty1.service container-getty@1.service; do
                    systemctl cat "$unit" >/dev/null 2>&1 || continue
                    systemctl is-active --quiet "$unit" \
                        || systemctl start "$unit" 2>/dev/null || true
                done
            fi
        fi
    else
        # fresh install ($2 is empty) - enable services
        systemctl enable inithooks.service
        systemctl enable turnkey-init-fence.service
    fi
fi

chmod 755 /usr/lib/python3/dist-packages/libinithooks/inithooks_cache.py

# The security alerts screen of older versions left this job behind; it
# posts the operator's email address to the TurnKey Hub every hour until
# the Hub answers. bin/secalerts.sh no longer writes it; an upgrade removes
# one an earlier first boot wrote.
rm -f /etc/cron.hourly/enable_secalerts

# dh_installsystemd enables keel-host-keys.service here (debian/rules says
# which units it may touch), and dh_python3 byte-compiles the modules. Without
# this token neither runs: keel-host-keys.service was never enabled, and a
# machine whose image carries no host key booted an sshd with none.
#DEBHELPER#

exit 0
