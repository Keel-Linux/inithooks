"""
Execute firstboot initialization hooks, skipping blacklist

Refuses, and exits 75, while another first boot run is in progress (the
one inithooks starts at boot waits on the console): two runs at once would
configure the machine twice. Refuses the same way while the first boot's
own run (inithooks.service) is starting, since it does what keel-init
skips; when the first boot is pending and nothing will run it, runs that
boot run (/usr/lib/inithooks/run) in its place.

firstboot.d hook execution environment:

    _TURNKEY_INIT=1

"""
import os
import sys

from conffile import ConfFile
import subprocess

from libinithooks import init_lock


def prog():
    return os.path.basename(sys.argv[0])


def fatal(e):
    print("%s: error: %s" % (prog(), e), file=sys.stderr)
    sys.exit(1)


def usage(e=None):
    if e:
        print("error: " + str(e), file=sys.stderr)

    print("Syntax: %s [-h|--help] [-c|--full-confconsole] [-s|--status]\n"
          % prog(), file=sys.stderr)
    print(__doc__.strip(), file=sys.stderr)
    print("\nOptions:\n")
    print("  -h|--help             - print this help and exit")
    print("  -c|--full-confconsole - after initialization open full confconsole (default is basic).")
    print("                          If Confconsole not installed, will be ignored.")
    print("  -s|--status           - say whether initialization is still pending, and exit:")
    print("                          75 while a run is in progress or the first boot has")
    print("                          not finished, 0 otherwise")
    print("\nWhen the first boot has not finished and inithooks.service is not running")
    print("it, the boot run is run here instead of the hooks, with its own output.")
    print("\nBlacklist:\n", file=sys.stderr)
    for script in BLACKLIST:
        print("    %s" % script, file=sys.stderr)
    sys.exit(1)


# deprecated: hooks can use _TURNKEY_INIT to detect if they're running under
# keel-init
BLACKLIST = ['15regen-sslcert',
             '92etckeeper', ]


class Config(ConfFile):
    CONF_FILE = "/etc/default/inithooks"


class InitHooks:
    def __init__(self):
        self.conf = Config()

    @staticmethod
    def _exec(cmd):
        subprocess.run(['env',
                        'PATH=/usr/local/sbin:/usr/local/bin:'
                        '/usr/sbin:/usr/bin:/sbin:/bin',
                        cmd])

    def execute(self, dname):
        os.environ['_TURNKEY_INIT'] = '1'
        dpath = os.path.join(self.conf.inithooks_path, dname)
        if not os.path.exists(dpath):
            return

        scripts = os.listdir(dpath)
        scripts.sort()
        for fname in scripts:
            fpath = os.path.join(dpath, fname)
            if os.access(fpath, os.X_OK) and fname not in BLACKLIST:
                self._exec(fpath)


def fence_up():
    try:
        done = subprocess.run(['systemctl', 'is-active', '--quiet',
                               'turnkey-init-fence'])
    except OSError:
        return False
    return done.returncode == 0


def boot_pending():
    return init_lock.boot_pending(init_lock.default_path(),
                                  init_lock.complete_path())


def status():
    """What the login message says while initialization is pending"""
    run = init_lock.in_progress(init_lock.lock_path())
    if run:
        print("    " + init_lock.wait_message(run, init_lock.detect_virt()))
        print()
        sys.exit(init_lock.EXIT_BUSY)
    if boot_pending():
        if init_lock.boot_unit_state() == "stopped":
            print("    " + init_lock.not_run_message())
        else:
            print("    " + init_lock.pending_message(init_lock.detect_virt()))
        print()
        sys.exit(init_lock.EXIT_BUSY)
    if fence_up():
        print("    This system is not initialized yet: run keel-init to"
              " set it up.")
        print()
    sys.exit(0)


def refuse(message):
    print("%s: %s" % (prog(), message), file=sys.stderr)
    sys.exit(init_lock.EXIT_BUSY)


def take_lock(boot_run):
    """The lock, for keel-init's own hooks; or, while the first boot is
    pending, a refusal or the boot run BOOT_RUN in keel-init's place"""
    try:
        lock = init_lock.acquire(init_lock.lock_path(),
                                 init_lock.this_keel_init())
    except init_lock.Busy as busy:
        virt = init_lock.detect_virt()
        print("%s: %s" % (prog(), init_lock.wait_message(busy.run, virt)),
              file=sys.stderr)
        refuse("two runs at once would configure this machine twice;"
               " run %s again once that one has finished." % prog())
    # Holding the lock, the boot run cannot start or finish under us. Before
    # it has run, the first boot is its job: hooks skip what only a first
    # boot does under keel-init (_TURNKEY_INIT), 98finalize would set
    # RUN_FIRSTBOOT=false, and the boot run would then skip the first boot.
    if not boot_pending():
        return lock
    state = init_lock.boot_unit_state()
    init_lock.release(lock)
    if state != "stopped":
        refuse(init_lock.pending_message(init_lock.detect_virt()))
    # Nothing will run the first boot: the unit was stopped, the run was
    # killed, or a container condition skipped the unit, which then never
    # runs. Refusing would lock the operator out; the boot run itself does
    # the whole first boot, on this terminal. It takes the lock again, and
    # a unit started meanwhile waits for it and then finds the first boot
    # done.
    print("%s: %s" % (prog(), init_lock.takeover_message(boot_run)),
          file=sys.stderr)
    sys.stderr.flush()
    os.execv(boot_run, [boot_run])


def main():
    args = sys.argv[1:]
    # neither needs root: the login message asks for the status, and the
    # lock file is readable by anybody
    if '-h' in args or '--help' in args:
        usage()
    if '-s' in args or '--status' in args:
        status()

    if os.geteuid() != 0:
        fatal("%s must be run with root permissions" % prog())

    confconsole = '/usr/bin/confconsole'
    if os.path.exists(confconsole) and os.access(confconsole, os.X_OK):
        confconsole = [confconsole, '--usage']
    else:
        # /bin/true ignores args and always returns true
        confconsole = ['/bin/true', '--null']

    if '-c' in args or '--full-confconsole' in args:
        confconsole = confconsole[:-1]

    inithooks = InitHooks()
    lock = take_lock(os.path.join(inithooks.conf.inithooks_path, 'run'))
    inithooks.execute('firstboot.d')
    # confconsole stays open for as long as the operator wants it: the run
    # is over, and the next one must not be refused because of it
    init_lock.release(lock)

    subprocess.run(confconsole)


if __name__ == "__main__":
    main()
